# Supabase → Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon 또는 publishable 키>

# rom-back 주소
NEXT_PUBLIC_API_URL=http://localhost:4000

# 서비스 도메인 (메타데이터·og:image·sitemap 절대 URL에 사용, 끝에 / 없이)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 카카오 로그인 때 전화번호 제공 동의를 요청할지. 카카오 콘솔에서 "전화번호" 동의항목을 켠 뒤에만 true로 바꾼다
# (콘솔 설정 없이 켜면 카카오가 잘못된 동의항목(KOE205)으로 로그인을 막는다)
NEXT_PUBLIC_KAKAO_PHONE_SCOPE=false
